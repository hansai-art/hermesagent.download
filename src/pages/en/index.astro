---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { CATEGORIES } from '../../config/categories.mjs';

const enArticles = (await getCollection('en')).filter(
  (a) => a.data.status !== 'draft' && a.data.status !== 'archived',
);
const countByCat = new Map();
for (const a of enArticles) {
  const c = a.id.split('/')[0];
  countByCat.set(c, (countByCat.get(c) ?? 0) + 1);
}
const activeCategories = CATEGORIES.filter((c) => (countByCat.get(c.slug) ?? 0) > 0);
const latest = [...enArticles]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6);
---

<Base
  title="HermesAgent.download — community knowledge base for Hermes Agent"
  description="Community-run knowledge base for Hermes Agent, the open-source AI agent by Nous Research. Errors, fixes, setup, and resources — every page sourced from official docs. Unofficial, not affiliated with Nous Research."
  lang="en"
  brand={false}
>
  <section class="mb-10">
    <div class="text-sm mb-4">
      <a href="/" style="color: var(--accent)">中文版</a>
    </div>
    <h1 class="text-4xl font-bold mb-3">
      <span style="color: var(--accent)">Hermes</span><span>Agent</span>.download
    </h1>
    <p class="text-lg mb-2" style="color: var(--text)">
      A community knowledge base for <strong>Hermes Agent</strong> — the open-source AI agent by Nous Research.
    </p>
    <p class="text-sm" style="color: var(--text-dim)">
      Errors, fixes, setup and resources. Every page cites the official source. Unofficial and not
      affiliated with Nous Research; download links always point to the official source. The English
      edition is growing — the Traditional Chinese edition is more complete for now.
    </p>
  </section>

  <section class="mb-10">
    <h2 class="text-xl font-semibold mb-4">Browse by category</h2>
    <div class="flex flex-wrap gap-2">
      {
        activeCategories.map((c) => (
          <a
            href={`/en/${c.slug}/`}
            class="rounded-lg border px-3 py-2 text-sm transition-colors hover:border-[var(--accent-dim)]"
            style="border-color: var(--border); background: var(--bg-raised); color: var(--text)"
          >
            {c.emoji} {c.name}
            <span style="color: var(--text-dim)"> · {countByCat.get(c.slug)}</span>
          </a>
        ))
      }
    </div>
  </section>

  {
    latest.length > 0 && (
      <section>
        <h2 class="text-xl font-semibold mb-4">Latest</h2>
        <div class="grid md:grid-cols-2 gap-3">
          {latest.map((a) => (
            <ArticleCard
              id={a.id}
              title={a.data.title}
              description={a.data.description}
              status={a.data.status}
              hermesVersion={a.data.hermes_version}
              prefix="/en"
            />
          ))}
        </div>
      </section>
    )
  }
</Base>
