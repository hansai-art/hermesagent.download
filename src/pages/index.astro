---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { CATEGORIES } from '../config/categories.mjs';
import dashboard from '../../data/dashboard.json';

const articles = (await getCollection('zh-TW')).filter(
  (a) => a.data.status !== 'draft' && a.data.status !== 'archived',
);
const latest = [...articles]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6);

const countByCategory = new Map<string, number>();
for (const a of articles) {
  const cat = a.id.split('/')[0];
  countByCategory.set(cat, (countByCategory.get(cat) ?? 0) + 1);
}

// 挑拿得出手的四個：issue 中文精選是這個站的獨有價值，放在文章總數旁邊
const issueCount = dashboard.content.byCategory.find((c) => c.slug === 'issues')?.count ?? 0;
const vitals = [
  { n: dashboard.content.total, label: '篇中文文件' },
  { n: issueCount, label: '篇官方 issue 精選' },
  { n: `${dashboard.credibility.withSourcesPct}%`, label: '有官方來源' },
  { n: dashboard.credibility.verifiedFresh, label: '篇近期實測' },
];

// 設備需求速查：數字對齊 /install/system-requirements/，改這裡要一起改那頁
// 雲端欄的記憶體與硬碟是本站在 MacBook Air M1 上的實測，本機模型欄取自官方 local-ollama-setup
const specRoutes = [
  {
    icon: '☁️',
    title: '借用別人的 AI',
    who: '多數人走這條。AI 在別人的電腦裡跑，你這台只負責把問題送出去、把答案收回來',
    specs: [
      { k: '記憶體', v: '8 GB 就夠' },
      { k: '硬碟', v: '留 15 GB' },
      { k: '顯示卡', v: '不需要' },
      { k: '處理器', v: '沒有下限' },
    ],
    note: '本站實測：Hermes 本身閒置時只佔 84 MB，開一個對話尖峰 166 MB。把它當成多開一個瀏覽器分頁的等級來規劃，不是多開一台虛擬電腦。這是參考值，你開了哪些功能會讓數字明顯不同。',
  },
  {
    icon: '🖥️',
    title: '在自己電腦跑 AI',
    who: '不想付使用費，或資料不能離開自己的機器。AI 模型整包下載到你的硬碟',
    specs: [
      { k: '記憶體', v: '16 GB 起跳' },
      { k: '硬碟', v: '30 GB 以上' },
      { k: '顯示卡', v: '建議 NVIDIA 8 GB' },
      { k: '處理器', v: '8 核心以上' },
    ],
    note: '門檻看你走哪條路：Ollama 配官方那張表的模型要 24 GB，Mac 用 llama.cpp 或 MLX 跑 Qwen3.5-9B 則 16 GB 就堪用。另有一條硬性要求：模型的 context 必須 64K 以上，不夠會被直接擋下來。',
  },
];

const routes = [
  {
    icon: '🚪',
    title: '我第一次接觸 Hermes Agent',
    desc: '五分鐘搞懂它是什麼、跟其他 AI 助手差在哪',
    href: '/concepts/什麼是-hermes-agent/',
  },
  {
    icon: '💻',
    title: '我想直接裝起來用',
    desc: 'macOS / Windows / Linux / WSL2 逐步安裝，指令取自官方文件',
    href: '/install/',
  },
  {
    icon: '🚑',
    title: '我卡在某個錯誤',
    desc: 'command not found、API key、context 上限、Telegram 踩坑逐題解',
    href: '/troubleshoot/overview/',
  },
  {
    icon: '✋',
    title: '我想幫忙補內容',
    desc: '從兩分鐘的錯誤回報，到捐出用不完的 AI 額度',
    href: '/contribute/',
  },
];
---

<Base title="HermesAgent.download — Hermes Agent 中文社群知識庫">
  <!-- Hero -->
  <section class="py-12 text-center">
    <h1 class="text-4xl md:text-5xl font-bold mb-4 leading-tight">
      Hermes Agent <span style="color: var(--accent)">中文</span>社群知識庫
    </h1>
    <p class="max-w-2xl mx-auto text-lg mb-3" style="color: var(--text)">
      別人踩過的坑，先幫你跳過。
    </p>
    <p class="max-w-2xl mx-auto mb-8 text-sm" style="color: var(--text-dim)">
      這裡的每一篇，都是有人解完隨手留下的。安裝、設定、踩坑、官方 issue 中文精選——
      你先拿走答案，哪天你也解出一個新的，再順手留下就好。
    </p>

    <!-- 生命徵象 -->
    <a
      href="/dashboard/"
      class="inline-flex flex-wrap justify-center gap-x-6 gap-y-2 rounded-lg border px-6 py-3 mb-8"
      style="border-color: var(--border); background: var(--bg-raised)"
    >
      {
        vitals.map((v) => (
          <span class="text-sm">
            <span class="font-bold tabular-nums" style="color: var(--accent)">
              {v.n}
            </span>
            <span class="ml-1" style="color: var(--text-dim)">
              {v.label}
            </span>
          </span>
        ))
      }
    </a>
  </section>

  <!-- 意圖分流 -->
  <section class="mb-14">
    <div class="grid sm:grid-cols-2 gap-3">
      {
        routes.map((r) => (
          <a
            href={r.href}
            class="rounded-lg border p-5 transition-colors hover:border-[var(--accent-dim)]"
            style="border-color: var(--border); background: var(--bg-raised)"
          >
            <div class="text-2xl mb-2">{r.icon}</div>
            <div class="font-semibold mb-1" style="color: var(--text)">
              {r.title}
            </div>
            <div class="text-sm" style="color: var(--text-dim)">
              {r.desc}
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- 設備需求速查 -->
  <section class="mb-14">
    <h2 class="text-xl font-bold mb-1">我的電腦跑得動嗎？</h2>
    <p class="text-sm mb-4" style="color: var(--text-dim)">
      官方文件沒有完整寫過這件事。答案取決於你走哪一條路，兩條路的門檻差三倍以上。下面的實測數字由本站補上，只能當參考。
    </p>

    <div class="grid sm:grid-cols-2 gap-3">
      {
        specRoutes.map((s) => (
          <div
            class="rounded-lg border p-5"
            style="border-color: var(--border); background: var(--bg-raised)"
          >
            <div class="flex items-baseline gap-2 mb-1">
              <span class="text-lg">{s.icon}</span>
              <span class="font-semibold" style="color: var(--text)">
                {s.title}
              </span>
            </div>
            <p class="text-xs mb-4" style="color: var(--text-dim)">
              {s.who}
            </p>

            <dl class="space-y-2 text-sm">
              {s.specs.map((row) => (
                <div class="flex items-baseline justify-between gap-3">
                  <dt style="color: var(--text-dim)">{row.k}</dt>
                  <dd class="font-semibold tabular-nums text-right" style="color: var(--accent)">
                    {row.v}
                  </dd>
                </div>
              ))}
            </dl>

            <p class="mt-4 pt-3 border-t text-xs" style="border-color: var(--border); color: var(--text-dim)">
              {s.note}
            </p>
          </div>
        ))
      }
    </div>

    <div
      class="mt-3 rounded-lg border px-5 py-4 text-sm"
      style="border-color: var(--accent-dim); background: var(--bg-raised); color: var(--text)"
    >
      <strong>先確認一件事：Intel 處理器的 Mac 官方明確不支援。</strong>
      <span style="color: var(--text-dim)">
        2020 年以前的 MacBook 多半是 Intel。開終端機跑
        <code class="rounded px-1" style="background: var(--bg)">uname -m</code>
        ，看到
        <code class="rounded px-1" style="background: var(--bg)">arm64</code>
        才裝得起來；看到
        <code class="rounded px-1" style="background: var(--bg)">x86_64</code>
        就是 Intel，再好的規格也沒用。
      </span>
    </div>

    <a
      href="/install/system-requirements/"
      class="inline-block mt-3 text-sm font-medium"
      style="color: var(--accent)"
    >
      完整說明：哪些電腦不能裝、可以跑哪些 AI 模型、硬碟要留多少 →
    </a>
  </section>

  <!-- 分類 -->
  <section class="mb-14">
    <h2 class="text-xl font-bold mb-4">全部分類</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
      {
        CATEGORIES.map((c) => (
          <a
            href={`/${c.slug}/`}
            class="rounded-lg border p-4 transition-colors hover:border-[var(--accent-dim)]"
            style="border-color: var(--border); background: var(--bg-raised)"
          >
            <div class="text-2xl mb-1">{c.emoji}</div>
            <div class="font-semibold" style="color: var(--text)">
              {c.name}
              <span class="text-xs font-normal ml-1" style="color: var(--text-dim)">
                {countByCategory.get(c.slug) ?? 0}
              </span>
            </div>
            <div class="text-xs mt-1 line-clamp-2" style="color: var(--text-dim)">
              {c.description}
            </div>
          </a>
        ))
      }
    </div>
  </section>

  {
    latest.length > 0 && (
      <section class="mb-14">
        <h2 class="text-xl font-bold mb-4">最新文章</h2>
        <div class="grid md:grid-cols-2 gap-3">
          {latest.map((a) => (
            <ArticleCard
              id={a.id}
              title={a.data.title}
              description={a.data.description}
              status={a.data.status}
              hermesVersion={a.data.hermes_version}
            />
          ))}
        </div>
      </section>
    )
  }

  <!-- 共筆號召 -->
  <section class="rounded-lg border p-6" style="border-color: var(--accent-dim); background: var(--bg-raised)">
    <h2 class="text-xl font-bold mb-2">留下一篇，先幫到的是未來的你</h2>
    <p class="text-sm mb-4" style="color: var(--text-dim)">
      你現在解出來的問題，三個月後多半會忘記怎麼解——寫下來，第一個受惠的是那時候的你自己。
      而且你的名字會掛在上面被搜尋、被 AI 引用；這裡才 {dashboard.content.gaps.length}
      個分類還很空，現在寫的會直接定義那個分類的樣子，而不是淹沒在三百篇裡。
      不會寫也算數：回報一個錯誤兩分鐘，或把用不完的 AI 額度借十五分鐘。
    </p>
    <div class="flex flex-wrap gap-3">
      <a href="/contribute/" class="rounded-md px-5 py-2 font-medium" style="background: var(--accent); color: var(--bg)">
        看我能得到什麼
      </a>
      <a href="/dashboard/" class="rounded-md px-5 py-2 border" style="border-color: var(--border); color: var(--text)">
        看這個站的數據
      </a>
    </div>
  </section>
</Base>
