---
import { getCollection } from 'astro:content';
import ArticlePage from '../../components/ArticlePage.astro';

export async function getStaticPaths() {
  const SITE = 'https://hermesagent.download';
  const [zh, en] = await Promise.all([getCollection('zh-TW'), getCollection('en')]);
  // 用 translationKey(退回 id)把英文版配對起來,支援中英不同 slug。
  const enByKey = new Map(
    en.filter((e) => e.data.status !== 'draft').map((e) => [e.data.translationKey ?? e.id, e]),
  );
  return zh
    .filter((e) => e.data.status !== 'draft')
    .map((e) => {
      const [category, ...rest] = e.id.split('/');
      const enMatch = enByKey.get(e.data.translationKey ?? e.id);
      const alternates = enMatch
        ? [
            { hreflang: 'zh-TW', href: `${SITE}/${e.id}/` },
            { hreflang: 'en', href: `${SITE}/en/${enMatch.id}/` },
            { hreflang: 'x-default', href: `${SITE}/${e.id}/` },
          ]
        : [];
      return { params: { category, slug: rest.join('/') }, props: { entry: e, alternates } };
    });
}

const { entry, alternates } = Astro.props;
---

<ArticlePage entry={entry} locale="zh-TW" alternates={alternates} />
