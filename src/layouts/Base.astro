---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  // 每頁可選的 structured data(TechArticle / BreadcrumbList 等),
  // 傳進來會與站台層級的 Organization schema 一起注入 <head>。
  schema?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: string;
  // 首頁的標題本身就以品牌開頭，不需要再接後綴。
  brand?: boolean;
  // 對搜尋引擎隱藏索引（薄的 issue 鏡像頁用），仍保留 follow 讓連結權重流動。
  noindex?: boolean;
}

const {
  title,
  description = 'Hermes Agent 中文社群知識庫：共筆、開源、自動進化',
  schema,
  ogType = 'website',
  brand = true,
  noindex = false,
} = Astro.props;

// 標題後綴由這裡統一決定，call site 只傳頁面本身的標題。
//
// 為什麼要判斷寬度（2026-07-30 量測）：
// 391 頁裡有 322 頁的 <title> 顯示寬度超過 60（全形算 2，約 600px 的 SERP 預算），
// 中位數 84，最長 149。issues/ 的標題本身就是完整錯誤字串，而那串字正是使用者會搜的字，
// NEVER 截斷它。但「｜HermesAgent.download」固定吃掉 21 格寬度，
// 在已經超預算的頁面上，那 21 格等於用品牌名蓋掉使用者真正要看的錯誤訊息。
// 所以：放得下就掛品牌，放不下就讓內容佔滿。
const BRAND = 'HermesAgent.download';
const BRAND_SEPARATOR = '｜';
const TITLE_BUDGET = 60;

function displayWidth(value: string) {
  let width = 0;
  for (const char of value) width += (char.codePointAt(0) ?? 0) > 0x2e80 ? 2 : 1;
  return width;
}

const brandSuffix = `${BRAND_SEPARATOR}${BRAND}`;
// 標題本身已經含品牌名就不要再接一次（/about/ 的標題是「關於 HermesAgent.download」）。
const documentTitle =
  brand && !title.includes(BRAND) && displayWidth(title) + displayWidth(brandSuffix) <= TITLE_BUDGET
    ? `${title}${brandSuffix}`
    : title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

// Organization schema：讓搜尋引擎把本站認成一個實體，而不是散落的頁面。
// sameAs 宣告的是「同一個經營者」，與「與 Nous Research 無隸屬關係」不衝突：
// 前者講誰在維護這個站，後者講這個站不代表上游專案。
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://hermesagent.download/#org',
  name: 'HermesAgent.download',
  url: 'https://hermesagent.download/',
  description:
    'Hermes Agent(Nous Research 開源 AI agent)的非官方中文社群知識庫，與 Nous Research 無隸屬關係。',
  sameAs: [
    'https://github.com/hansai-art/hermesagent.download',
    'https://www.techhanlin.tw',
    'https://aiterms.tw',
  ],
};
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} is:inline />
    {
      pageSchemas.map((s) => (
        <script type="application/ld+json" set:html={JSON.stringify(s)} is:inline />
      ))
    }
    <Analytics />
  </head>
  <body class="min-h-screen flex flex-col" style="background: var(--bg)">
    <Header />
    <main class="flex-1 w-full max-w-5xl mx-auto px-5 py-10">
      <slot />
    </main>
    <Footer />
  </body>
</html>
