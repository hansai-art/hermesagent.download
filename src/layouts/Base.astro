---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  // 每頁可選的 structured data(TechArticle / BreadcrumbList 等),
  // 傳進來會與站台層級的 Organization schema 一起注入 <head>。
  schema?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: string;
}

const {
  title,
  description = 'Hermes Agent 中文社群知識庫 — 共筆、開源、自動進化',
  schema,
  ogType = 'website',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

// Organization schema:讓搜尋引擎把本站認成一個實體,而不是散落的頁面。
// sameAs 宣告的是「同一個經營者」,與「與 Nous Research 無隸屬關係」不衝突:
// 前者講誰在維護這個站,後者講這個站不代表上游專案。
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://hermesagent.download/#org',
  name: 'HermesAgent.download',
  url: 'https://hermesagent.download/',
  description:
    'Hermes Agent(Nous Research 開源 AI agent)的非官方中文社群知識庫,與 Nous Research 無隸屬關係。',
  sameAs: [
    'https://github.com/hansai-art/hermesagent.download',
    'https://www.techhanlin.tw',
    'https://aiterms.tw',
  ],
};
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} is:inline />
    {
      pageSchemas.map((s) => (
        <script type="application/ld+json" set:html={JSON.stringify(s)} is:inline />
      ))
    }
    <Analytics />
  </head>
  <body class="min-h-screen flex flex-col" style="background: var(--bg)">
    <Header />
    <main class="flex-1 w-full max-w-5xl mx-auto px-5 py-10">
      <slot />
    </main>
    <Footer />
  </body>
</html>
